# HTTP: only redirects to HTTPS (and answers certificate renewal challenges)
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/hermes-route;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: actually serves your site
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/3.148.240.163/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/3.148.240.163/privkey.pem;

    root /srv/hermes-route/site;
    index index.html index.htm;
    include snippets/ws.conf;

    location / {
        try_files $uri $uri/ =404;
    }
}
